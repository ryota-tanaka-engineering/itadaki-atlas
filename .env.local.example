# Supabase
# プロジェクト作成後に Settings > API から取得する（東京 ap-northeast-1 / Free）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key は RLS をバイパスする。
# サーバー側の処理（CSVインポート等）でのみ使用し、クライアントへ絶対に露出させない。
# 詳細: .doc/10_system/06_security.md
SUPABASE_SERVICE_ROLE_KEY=

# Sentry（初回デプロイ時に導入）
SENTRY_DSN=

# 地図タイル（Protomaps / PMTiles を R2 から配信）
# 詳細: .doc/10_system/02_infrastructure.md §2
NEXT_PUBLIC_PMTILES_URL=
